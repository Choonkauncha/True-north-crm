# Vercel/production: use a managed PostgreSQL connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# At least 32 random characters. Keep this secret.
TN_SESSION_SECRET="replace-with-a-long-random-secret"

# Configure the environment variables required by your z-ai-web-dev-sdk deployment.
# The AI routes already return actionable errors when the provider is unavailable.

# Geocodio server-side address verification.
# Keep this secret; do not expose it to browser code.
GEOCODIO_API_KEY="replace-with-geocodio-api-key"
